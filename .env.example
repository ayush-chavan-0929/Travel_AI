# Travel_AI Environment Configuration
# All APIs used in Travel_AI are 100% free by default!

# Google Gemini API Key (Free tier from Google AI Studio):
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Open-Meteo: 100% Free weather forecast API (No key needed)
# OpenStreetMap / Nominatim: Free geographic routing (No key needed)

# Model configuration
GEMINI_MODEL=gemini-2.5-flash

# Database Configuration
DATABASE_URL=sqlite:///./data/travel_ai.db
